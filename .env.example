# ---------------------------------------------------------------------------
# Dashboard (packages/dashboard/.env.local)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Where the edge worker is reachable. Used for cache purges + DNS verification.
FS_EDGE_BASE_URL=https://edge.foundershield.dev
FS_ADMIN_KEY=generate_with__openssl_rand_-hex_32

# The hostname customers point their CNAME at.
NEXT_PUBLIC_FS_EDGE_HOSTNAME=proxy.foundershield.dev

# Where the dashboard itself is reachable. Used to build signing links, which
# are sent to people who have no account here — so a wrong value produces links
# that do not resolve.
NEXT_PUBLIC_APP_URL=https://app.foundershield.dev

# ---------------------------------------------------------------------------
# Stripe (entirely optional)
#
# With none of these set, the dashboard runs on the free plan and the pricing
# grid says billing is not configured. Nothing else changes — billing is a way
# to charge for the product, not a dependency of it.
#
# Prices live in Stripe rather than in code: a price id is per-account and
# differs between test and live mode.
# ---------------------------------------------------------------------------
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...          # from `stripe listen` or the dashboard
# STRIPE_PRICE_SOLO=price_...
# STRIPE_PRICE_INDIE=price_...
# STRIPE_PRICE_STUDIO=price_...
# STRIPE_PRICE_AGENCY=price_...

# ---------------------------------------------------------------------------
# Edge worker (packages/edge/.dev.vars -- same keys, no NEXT_PUBLIC_ prefix)
# ---------------------------------------------------------------------------
# SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
# FS_ADMIN_KEY=same_value_as_dashboard
#
# Optional: run the proxy with zero Supabase dependency (local dev / demos).
# A JSON array of EdgeProjectConfig objects; see packages/shared/src/config.ts
# FS_CONFIG_FALLBACK=[{"projectId":"local","domain":"localhost", ...}]
